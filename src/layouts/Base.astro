---
import '../styles/global.css';
import { site, url } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url('social.png'), Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05060f" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Screenshots in the visitor's chosen (or the system's) appearance, set before the page draws.
      document.documentElement.classList.remove('no-js');
      try {
        var saved = localStorage.getItem('landeck-shots');
        var light = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.shots = saved || (light ? 'light' : 'dark');
      } catch (e) {
        document.documentElement.dataset.shots = 'dark';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url()}>
          <img src={url('favicon.svg')} alt="" width="30" height="30" />
          <span>LanDeck</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a class="nav-optional" href={url('#features')}>Features</a>
          <a class="nav-optional" href={url('#security')}>Security</a>
          <a href={url('#pro')}>Pro</a>
          <a class="nav-optional" href={url('#faq')}>FAQ</a>
          <a class="nav-support" href={url('support/')}>Support</a>
          <a class="nav-cta" href={url('#download')}>Get LanDeck</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src={url('favicon.svg')} alt="" width="22" height="22" />
          <span>{site.copyright}. LanDeck is a Mac app; Mac and macOS are trademarks of Apple Inc.</span>
        </div>
        <nav aria-label="Footer">
          <a href={url('privacy/')}>Privacy</a>
          <a href={url('support/')}>Support</a>
          <a href={site.releasesUrl}>Releases</a>
        </nav>
      </div>
    </footer>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // The header gets a line once the page scrolls.
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Things that animate when they come into view.
      const revealer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            revealer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal], .note-stack, .menubar-demo').forEach((el) => revealer.observe(el));

      // Numbers that count up.
      const counter = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            counter.unobserve(entry.target);
            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count);
            const decimals = (el.dataset.count?.split('.')[1] ?? '').length;
            const format = (n: number) =>
              n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
            if (reduceMotion) {
              el.textContent = format(target);
              continue;
            }
            const start = performance.now();
            const duration = 1600;
            const step = (now: number) => {
              const t = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - t, 4);
              el.textContent = format(target * eased);
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        },
        { threshold: 0.6 },
      );
      document.querySelectorAll('[data-count]').forEach((el) => counter.observe(el));

      // The hero window leans back and straightens as the page scrolls.
      const heroWindow = document.querySelector<HTMLElement>('.hero-window');
      if (heroWindow && !reduceMotion) {
        const tilt = () => {
          const progress = Math.min(1, Math.max(0, window.scrollY / 520));
          heroWindow.style.setProperty('--tilt', `${18 * (1 - progress)}deg`);
          heroWindow.style.setProperty('--zoom', `${0.94 + 0.06 * progress}`);
        };
        tilt();
        window.addEventListener('scroll', () => requestAnimationFrame(tilt), { passive: true });
      }

      // Cards light up under the pointer.
      document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const box = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - box.left}px`);
          card.style.setProperty('--my', `${event.clientY - box.top}px`);
        });
      });

      // Screenshots: dark or light.
      const switches = document.querySelectorAll<HTMLButtonElement>('[data-shots-choice]');
      const showShots = (choice: string) => {
        document.documentElement.dataset.shots = choice;
        switches.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.shotsChoice === choice)));
      };
      showShots(document.documentElement.dataset.shots ?? 'dark');
      switches.forEach((button) =>
        button.addEventListener('click', () => {
          const choice = button.dataset.shotsChoice ?? 'dark';
          showShots(choice);
          try {
            localStorage.setItem('landeck-shots', choice);
          } catch {
            // Private browsing: the choice lasts for this page.
          }
        }),
      );

      // Tabs that change screenshots by themselves while in view, until the visitor picks one.
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((group) => {
        const tabs = [...group.querySelectorAll<HTMLButtonElement>('.tab')];
        const panels = [...group.querySelectorAll<HTMLElement>('.tab-panel')];
        const strip = group.querySelector<HTMLElement>('.tabs');
        const interval = Number(group.dataset.tabs) || 6000;
        strip?.style.setProperty('--tab-time', `${interval}ms`);
        let current = 0;
        let timer: number | undefined;
        let visible = false;
        const select = (index: number) => {
          current = index;
          tabs.forEach((tab, i) => tab.setAttribute('aria-selected', String(i === index)));
          panels.forEach((panel, i) => panel.classList.toggle('active', i === index));
        };
        const schedule = () => {
          window.clearInterval(timer);
          if (reduceMotion || strip?.classList.contains('paused') || !visible) return;
          timer = window.setInterval(() => select((current + 1) % tabs.length), interval);
        };
        tabs.forEach((tab, index) =>
          tab.addEventListener('click', () => {
            strip?.classList.add('paused');
            window.clearInterval(timer);
            select(index);
          }),
        );
        new IntersectionObserver((entries) => {
          visible = entries.some((entry) => entry.isIntersecting);
          schedule();
        }, { threshold: 0.3 }).observe(group);
        select(0);
      });
    </script>
  </body>
</html>
